HOST=127.0.0.1
PORT=3001
# Generate ADMIN_EMAIL and ADMIN_PASSWORD with npm run server:init.
# Set HOST=0.0.0.0 to test from a phone on your own local network.
# PUBLIC_URL is the externally reachable HTTPS origin for revocable teacher links.
PUBLIC_URL=
ALLOW_REGISTRATION=true
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,http://localhost:8082,http://127.0.0.1:8082
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
